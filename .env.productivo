RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_MAX_AUTH_REQUESTS=2000
RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_RESET_SECRET (opcional) — tipo: texto (string), NO es un número.
# Mínimo 24 caracteres en el backend; si falta o es corto, el endpoint no existe (404).
# Recomendado: openssl rand -base64 32  →  mezcla A-Za-z0-9 y símbolos +/= (alfanumérico Base64).
# Enviar el MISMO valor en cabecera X-Rate-Limit-Reset-Secret (UTF-8, sin espacios extra).
# Docs: docs/SECURITY.md y docs/API.md (Rate limiting).
# curl: POST https://HOST:3000/api/system/rate-limit-reset  + JSON {"ip":"..."} o {"all":true}
RATE_LIMIT_RESET_SECRET=RNtCLXAZEX0w5VlQRUXOeXIiqvcNhRec3BDCEYJ4Hn0