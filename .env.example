# ========================================
# BITÁCORA SOC - Pre-Producción Environment
# ========================================
# IMPORTANTE: Configure estos valores antes de ejecutar
# No commitee este archivo con valores reales
# Copie este archivo a .env y modifique los valores

# Puertos
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443
BACKEND_PORT=3000
BACKEND_HTTPS_PORT=3443
HTTPS_PORT=3443

# Version (opcional, se inyecta en el build)
APP_VERSION=dev

# Host/Dominio del servidor (sin http://)
# Para servidor en red: deje como 0.0.0.0 para escuchar en todas las interfaces
# Cambie a IP específica si lo necesita (ej: 192.168.1.100)
HOST_DOMAIN=0.0.0.0

# URL pública del frontend usada en emails y enlaces externos (OPCIONAL).
# El sistema detecta automáticamente la URL desde el header Origin de cada request,
# por lo que esto NO necesita configurarse en la mayoría de los casos.
# Solo defínalo si la detección automática falla, por ejemplo en entornos donde
# los clientes no envían el header Origin (APIs externas, pruebas automatizadas).
#
# Ejemplos:
#   FRONTEND_URL=http://192.168.1.100:4200
#   FRONTEND_URL=https://192.168.1.100:4300
#   FRONTEND_URL=https://soc.midominio.cl
# FRONTEND_URL=

# CORS (opcional: se autodetecta host/protocol/puertos comunes)
# Orígenes extra permitidos separados por coma, incluyendo protocolo y puerto
# Ejemplos:
#   - http://10.0.100.13:4200
#   - https://soc.midominio.cl
ALLOWED_ORIGINS=https://soc.midominio.cl,http://localhost:4200

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
MONGO_DATABASE=bitacora_soc

# Usuario Administrador de la Aplicación (se crea automáticamente en el primer despliegue)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD  # OBLIGATORIO cambiar antes de usar
ADMIN_EMAIL=admin@bitacorasoc.local

# Backend - Seguridad
# JWT_SECRET: Genere con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=GENERATE_RANDOM_BASE64_SECRET_HERE

# ENCRYPTION_KEY: Para cifrar passwords SMTP con AES-256-GCM
# DEBE ser exactamente 64 caracteres hexadecimales (32 bytes = 256-bit key)
# Genere con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ejemplo: 2f74eefced33e94f965f610b23e9ce6347173fb9bf4b2757caab3268091edcf4
ENCRYPTION_KEY=GENERATE_RANDOM_64_CHAR_HEX_KEY_HERE

# JWT expiration (ejemplos: 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Cookie de sesión (auth_token)
# true  -> solo HTTPS (recomendado en producción con TLS)
# false -> permite HTTP (útil en red local sin certificado)
COOKIE_SECURE=false

# Rate Limiter (Protección contra ataques de fuerza bruta)
# Solo aplica en producción (NODE_ENV=production)
# Ventana de tiempo en milisegundos (default: 900000 = 15 minutos)
RATE_LIMIT_WINDOW_MS=900000
# Máximo de requests por ventana (default: 100, recomendado: 1000 para uso intensivo)
RATE_LIMIT_MAX_REQUESTS=1000

# RATE_LIMIT_RESET_SECRET (opcional) — tipo: texto (string), NO es un número.
# Mínimo 24 caracteres en el backend; si falta o es corto, el endpoint no existe (404).
# Recomendado: openssl rand -base64 32  →  mezcla A-Za-z0-9 y símbolos +/= (alfanumérico Base64).
# Enviar el MISMO valor en cabecera X-Rate-Limit-Reset-Secret (UTF-8, sin espacios extra).
# Docs: docs/SECURITY.md y docs/API.md (Rate limiting).
# curl: POST https://HOST:3000/api/system/rate-limit-reset  + JSON {"ip":"..."} o {"all":true}
RATE_LIMIT_RESET_SECRET=RNtCLXAZEX0w5VlQRUXOeXIiqvcNhRec3BDCEYJ4Hn0

# SMTP (Opcional - para notificaciones email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
