# ============================================================================
# Bitácora Ops 2.0 — variables de docker-compose.yml
# ============================================================================
# Copiar a .env (no versionado). Docker Compose lee .env de esta carpeta
# automáticamente. Los valores de abajo son SOLO para desarrollo local (son
# los mismos defaults que trae docker-compose.yml): en cualquier ambiente real
# cambiar los 4 secretos.
#
# No hay ADMIN_USERNAME/ADMIN_PASSWORD: el primer administrador se crea en el
# asistente de configuración (/setup) la primera vez que se entra a la app.
# Tampoco hay nada de MongoDB: eso era del legacy v1.x (../BitacoraSOC-legacy).

# PostgreSQL 18 (usuario y base: bitacora; expuesto solo en 127.0.0.1:25432)
POSTGRES_PASSWORD=bitacora_dev_local

# Firma de los JWT de sesión (cualquier string largo y aleatorio)
JWT_SIGNING_KEY=dev-only-jwt-signing-key-cambiar-en-produccion

# AES-256-GCM para secretos en reposo (contraseña SMTP, secretos TOTP).
# 32 bytes en base64 — generar con: openssl rand -base64 32
# Cambiarla con datos cargados deja ilegibles los secretos ya cifrados.
APP_ENCRYPTION_KEY=dkbE1vL8G50ufsA0EsATSDDsu+F1LAhKNNykSrG9Z3w=

# URL pública con la que se arman los enlaces de los correos (ej. reset de contraseña)
PUBLIC_BASE_URL=http://127.0.0.1:8081

# Secreto compartido para POST /api/system/rate-limit-reset. Vacío = endpoint desactivado (404).
RATE_LIMIT_RESET_SECRET=

# ----------------------------------------------------------------------------
# Admin por defecto (OPCIONAL, pensado para desarrollo/pruebas)
# ----------------------------------------------------------------------------
# Si están definidos usuario y contraseña, al arrancar el backend crea este
# admin y completa el setup — pero SOLO si el setup todavía no se hizo (base
# vacía). Si ya hay un admin, se ignora: no crea usuarios ni cambia claves.
# Vacíos = se usa el asistente /setup (lo normal en producción).
# La contraseña debe tener al menos 12 caracteres.
# BOOTSTRAP_MODULES: both | soc | noc
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_MODULES=both
