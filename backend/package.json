{
  "name": "bitacora-soc-backend",
  "version": "1.8.0",
  "description": "Bitácora SOC - Backend Express + MongoDB",
  "main": "src/server.js",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "pnpm": "11.x"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=(process.env.npm_config_user_agent||'').toLowerCase(); const pm=(process.env.npm_config_package_manager||'').toLowerCase(); const exec=(process.env.npm_execpath||'').toLowerCase().split(String.fromCharCode(92)).join('/'); const ok=/\\bpnpm\\/11\\./.test(ua)||/^pnpm@11\\./.test(pm)||/pnpm\\/11\\./.test(exec); if(!ok){console.error('ERROR: Use pnpm@11.x only in this repository.'); process.exit(1)}\"",
    "build": "node -e \"console.log('Backend: no build step required (Node.js runtime)')\"",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "restart:clean": "node scripts/restart-clean.js",
    "seed": "node src/scripts/seed.js",
    "migrate:escalation-clients": "node src/scripts/migrate-escalation-clients-to-log-sources.js",
    "version:sync": "node ../scripts/sync-version.js",
    "test": "jest --passWithNoTests"
  },
  "keywords": [
    "soc",
    "bitacora",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "ajv": "^8.20.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mjml": "^5.3.0",
    "moment-timezone": "^0.6.2",
    "mongoose": "^8.24.0",
    "multer": "^2.2.0",
    "node-cron": "^4.3.0",
    "nodemailer": "^8.0.11",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-mongo": "^2.3.2",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "unzipper": "^0.12.3",
    "uuid": "^11.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "glob": "^13.0.6",
    "js-cookie": "^3.0.5"
  }
}
