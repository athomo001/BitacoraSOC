# Dependencies
node_modules/
*/node_modules/

# Environment
.env
.env.local
.env.production
.env.docker
.env.*
!.env.example
*.env.local

# Logs
*.log
npm-debug.log*
logs/

# Build outputs
dist/
*/dist/
build/
.angular/

# Excepción: placeholder mínimo versionado para //go:embed (backend-go/internal/web/spa.go).
# Sin esto, un clon fresco no tiene backend-go/internal/web/dist/browser/ y
# `go build ./...` falla de entrada (bug real detectado en CI: "pattern
# all:dist/browser: no matching files found"). El build real de Angular pisa
# este placeholder en Docker y en `scripts/sync-frontend.sh` — nunca se commitea
# el build real, solo este stub.
!/backend-go/internal/web/dist/
!/backend-go/internal/web/dist/browser/
!/backend-go/internal/web/dist/browser/**

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code (configuración local de Claude, no subir al repositorio)
.claude/

# OS
.DS_Store
Thumbs.db

# Uploads & Backups
uploads/
/backups/
# The frontend backup service is source code, not runtime backup data.
!frontend-v2/src/app/core/backups/
!frontend-v2/src/app/core/backups/**

# Docker
docker-compose.override.yml
.data/

# Herramientas locales de IA (no subir)
skills/*

# Watermarks locales de autor (no subir)
docs/AUTHOR_WATERMARKS.local.md

# Temporales de subida / Google Drive
*.tmp
.tmp/
.tmp.*/
.tmp.driveupload/
.agents/*

/spec/*