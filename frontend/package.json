{
  "name": "bitacora-soc-frontend",
  "version": "1.7.0",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "pnpm": "11.x"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=(process.env.npm_config_user_agent||'').toLowerCase(); const pm=(process.env.npm_config_package_manager||'').toLowerCase(); const exec=(process.env.npm_execpath||'').toLowerCase().split(String.fromCharCode(92)).join('/'); const ok=/\\bpnpm\\/11\\./.test(ua)||/^pnpm@11\\./.test(pm)||/pnpm\\/11\\./.test(exec); if(!ok){console.error('ERROR: Use pnpm@11.x only in this repository.'); process.exit(1)}\"",
    "ng": "ng",
    "start": "node start-dev.js",
    "start:ssl": "ng serve --host 0.0.0.0 --port 4200 --no-hmr --ssl true",
    "restart:clean": "node scripts/restart-clean.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "version:sync": "node ../scripts/sync-version.js",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.25",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/forms": "^20.3.25",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@angular/router": "^20.3.25",
    "@swimlane/ngx-charts": "^23.1.0",
    "animejs": "^3.2.2",
    "html2canvas": "^1.4.1",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.29",
    "@angular/cli": "^20.3.29",
    "@angular/compiler-cli": "^20.3.25",
    "@types/animejs": "^3.1.13",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "vite": "^7.3.2",
    "picomatch": "^4.0.4"
  }
}
