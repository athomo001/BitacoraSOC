# Ignore Node.js dependency directories
node_modules/
**/node_modules/
frontend/node_modules/
backend/node_modules/

# Ignore local database and Docker volume cache directories
.data/
**/.data/

# Ignore build outputs
dist/
**/dist/
.angular/
frontend/.angular/
build/

# Ignore local environment variables and secrets
.env
.env.*
.env.local
.env.production
.env.docker
ssl-cdc-server/

# Ignore IDE and OS configurations
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Ignore logs
*.log
npm-debug.log*
logs/

# Ignore Git files
.git/
.gitignore

# Ignore backups and temporary files
backups/
uploads/
*.tmp
.tmp/
.tmp.*/
